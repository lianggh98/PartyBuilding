# 复制为仓库根目录的 .env 后再填写。不要提交 .env，也不要使用示例里的占位符直接启动。

MYSQL_ROOT_PASSWORD="replace-with-a-strong-local-root-password"
MYSQL_DATABASE="party_foundation"
MYSQL_USER="partyapp"
MYSQL_PASSWORD="replace-with-a-strong-local-app-password"
REDIS_PASSWORD="replace-with-a-strong-local-redis-password"

# 仅绑定本机。25481 / 26381 被占用时再改成其他空闲高位端口。
MYSQL_PORT="25481"
REDIS_PORT="26381"

# foundation 后端。正式环境不要使用 dev profile。
# 值用双引号。DB_URL 含 &，不引用时 source .env 会失败。
SPRING_PROFILES_ACTIVE="dev"
DB_URL="jdbc:mysql://127.0.0.1:25481/party_foundation?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai"
DB_USERNAME="partyapp"
DB_PASSWORD="replace-with-the-same-value-as-MYSQL_PASSWORD"
JWT_SECRET="replace-with-at-least-32-random-characters"
DEV_ADMIN_PASSWORD="replace-with-a-strong-local-admin-password-min-12"
