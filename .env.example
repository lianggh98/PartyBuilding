# Copy to .env at the repository root; do NOT commit real passwords.
# Replace these placeholder values before starting the containers.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-root-password
MYSQL_DATABASE=partybuilding
MYSQL_USER=partyapp
MYSQL_PASSWORD=replace-with-a-strong-local-app-password
REDIS_PASSWORD=replace-with-a-strong-local-redis-password

# Host loopback only; change if these ports are occupied.
MYSQL_PORT=25481
REDIS_PORT=26381
